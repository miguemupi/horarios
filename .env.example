# URL pública exacta de la app, sin barra final
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PORT=3000
# En una VPS con proxy inverso, usar 127.0.0.1. Para acceso directo en red, 0.0.0.0.
BIND_ADDRESS=0.0.0.0

# La app lo guarda en data/config.json la primera vez; también se puede cambiar en Administración
GOOGLE_SPREADSHEET_ID=pega_aqui_el_id_del_spreadsheet
APP_TIMEZONE=Europe/Madrid

# Genera al menos 32 bytes aleatorios: openssl rand -hex 32
SESSION_SECRET=cambia-por-un-secreto-largo-y-aleatorio

# true únicamente si APP_URL usa HTTPS
COOKIE_SECURE=false

# Nunca habilitar en producción. Facilita pruebas internas sin sesión normal.
DEV_AUTH_BYPASS=false

# Permite una sesión pública de solo demostración, sin escrituras reales
DEMO_MODE=false

# PostgreSQL. Sustituir siempre la contraseña antes de producción.
POSTGRES_DB=partes_serendipia
POSTGRES_USER=partes_app
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_PORT=5434
DATABASE_URL=postgresql://partes_app:cambia-esta-contrasena@db:5432/partes_serendipia

# Exportación programada a Google Sheets, en la zona horaria APP_TIMEZONE
SHEET_SYNC_HOUR=23
SHEET_SYNC_MINUTE=55
SHEET_SYNC_INTERVAL_DAYS=15
# Fecha que inicia el ciclo. En producción, indicar la fecha de despliegue: YYYY-MM-DD.
SHEET_SYNC_ANCHOR_DATE=
